generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type UserProfile {
  firstName      String
  lastName       String
  profilePicture String?
}

model Exersice {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  category           String
  createdAt          DateTime @db.Date
  description        String?
  exerciseImgUrl     String?
  fileContentType    String?  // Legacy: Base64 encoded file (deprecated)
  fileName           String
  tags               String[]
  level              String?
  type               String?
  title              String
  updatedAt          DateTime @db.Date
  translation        Json?
  // Cloudinary fields (new)
  cloudinaryPublicId String?
  cloudinaryUrl      String?
  fileSize           Int?
  // Greg AI transcript bookkeeping. The transcript itself is the
  // ExerciseItem rows (one per problem in the booklet), made by
  // transcribeExercise() in exerciseTranscript.server.ts. `gregSource` is the
  // file they were made from (see exerciseSourceKey) — when the PDF is
  // replaced the two no longer match and the items are treated as stale.
  gregSource         String?
  gregTranscribedAt  DateTime? @db.Date
}

// One problem inside an exercise booklet PDF, transcribed for Greg AI.
// Markdown + LaTeX, in the booklet's original language.
model ExerciseItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  exerciseId String   @db.ObjectId
  // 1-based position in the booklet. This is the number Greg and the
  // get_exercise tool use — booklet labels repeat across chapters.
  order      Int
  section    String? // chapter / unit heading, when the booklet has one
  label      String // as printed: "Άσκηση 5", "Θέμα Β", "3."
  topic      String // one line, for Greg's table of contents and search
  statement  String
  solution   String? // tutor-only: Greg uses it to aim hints, never reveals it
  createdAt  DateTime @db.Date

  @@index([exerciseId, order])
}

// Book model for e-commerce
model Book {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String
  price              Float
  currency           String   @default("EUR")
  cloudinaryPublicId String
  cloudinaryUrl      String
  thumbnailUrl       String?
  stripePriceId      String?
  stripeProductId    String?
  isActive           Boolean  @default(true)
  category           String
  tags               String[]
  translation        Json?
  authorName         String?
  pageCount          Int?
  isbn               String?
  edition            String?
  discountPrice      Float?
  deletedAt          DateTime? @db.Date
  archivedPdfIds     String[]
  thumbnailPublicId  String?
  createdAt          DateTime @db.Date
  updatedAt          DateTime @db.Date
}

// Purchase model for tracking book purchases
model Purchase {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  bookId          String    @db.ObjectId
  stripeSessionId String?
  stripePaymentId String?
  amount          Float
  currency        String
  status          String    @default("pending") // pending, completed, failed, refunded
  downloadToken   String?   @unique
  downloadCount   Int       @default(0)
  maxDownloads    Int       @default(5)
  tokenExpiresAt  DateTime? @db.Date
  createdAt       DateTime  @db.Date
  updatedAt       DateTime  @db.Date
}

model Training {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  category        String
  content         String
  contentImage    String
  createdAt       DateTime @db.Date
  searchableTitle String
  solution        String
  solutionImage   String
  tags            String
  title           String
  updatedAt       DateTime @db.Date
  translation     Json?
}

model User {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime     @db.Date
  email     String       @unique
  password  String
  profile   UserProfile?
  role      String
  updatedAt DateTime     @db.Date
  isActive  Boolean      @default(false)
}

model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  category    String?
  createdAt   DateTime @db.Date
  creatorName String
  description String
  tags        String[]
  title       String
  updatedAt   DateTime @db.Date
  url         String
  translation  Json?
}

// Q&A System models
model Question {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  body            String
  category        String
  tags            String[]
  authorId        String   @db.ObjectId
  authorName      String
  voteCount       Int      @default(0)
  answerCount     Int      @default(0)
  viewCount       Int      @default(0)
  acceptedAnswerId String? @db.ObjectId
  isResolved      Boolean  @default(false)
  createdAt       DateTime @db.Date
  updatedAt       DateTime @db.Date
}

model Answer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId  String   @db.ObjectId
  body        String
  authorId    String   @db.ObjectId
  authorName  String
  voteCount   Int      @default(0)
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @db.Date
  updatedAt   DateTime @db.Date
}

model QuestionVote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId String   @db.ObjectId
  userId     String   @db.ObjectId
  value      Int      // 1 for upvote, -1 for downvote
  createdAt  DateTime @db.Date

  @@unique([questionId, userId])
}

model AnswerVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  answerId  String   @db.ObjectId
  userId    String   @db.ObjectId
  value     Int      // 1 for upvote, -1 for downvote
  createdAt DateTime @db.Date

  @@unique([answerId, userId])
}

// User Progress Tracking
model UserProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  exerciseId  String?   @db.ObjectId
  trainingId  String?   @db.ObjectId
  type        String    // "exercise_viewed", "training_completed", "quiz_score"
  score       Int?
  timeSpent   Int?      // seconds
  completedAt DateTime  @db.Date
  createdAt   DateTime  @db.Date

  @@index([userId])
  @@index([userId, type])
}

// Greg AI chatbot - persistent chat history per user
model GregChatSession {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  locale    String           @default("el")
  // The ExerciseItem the student is currently working on, set when Greg
  // opens one with get_exercise. Lets later turns carry that exercise in
  // the prompt without another tool round.
  activeItemId String?       @db.ObjectId
  createdAt DateTime         @db.Date
  updatedAt DateTime         @db.Date
  messages  GregChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model GregChatMessage {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String          @db.ObjectId
  session   GregChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String          // "user" | "assistant"
  content   String
  rating    Int?            // -1 = down, 1 = up, null = unset
  // Student messages only, for the teacher dashboard: which hint button was
  // pressed (1 hint, 2 bigger hint, 3 show solution) and where they were.
  hintLevel  Int?
  page       String?         // one of CHAT_PAGES
  contextKey String?         // exercise id or training title on that page
  createdAt DateTime        @db.Date

  @@index([sessionId, createdAt])
}

// Greg AI daily message quota — Mongo-persisted so it survives serverless cold starts
model GregDailyUsage {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  date   String // UTC calendar date, YYYY-MM-DD
  count  Int    @default(0)
  // Cost accounting. `spend` is the weighted total in input-token equivalents
  // (see costUnits() in anthropic.server.ts) — 1_000_000 units = $1 at Haiku
  // 4.5 rates. The raw counters are kept for reporting.
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  spend        Int @default(0)

  @@unique([userId, date])
  @@index([userId])
}

// Audit Logging for security
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  action     String   // "upload", "download", "purchase", "login"
  resource   String   // "exercise", "book", "training"
  resourceId String?  @db.ObjectId
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @db.Date
}

