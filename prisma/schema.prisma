generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type UserProfile {
  firstName      String
  lastName       String
  profilePicture String?
}

model Exersice {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  category           String
  createdAt          DateTime @db.Date
  description        String?
  exerciseImgUrl     String?
  fileContentType    String?  // Legacy: Base64 encoded file (deprecated)
  fileName           String
  tags               String
  title              String
  updatedAt          DateTime @db.Date
  translation        Json?
  // Cloudinary fields (new)
  cloudinaryPublicId String?
  cloudinaryUrl      String?
  fileSize           Int?
}

// Book model for e-commerce
model Book {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String
  price              Float
  currency           String   @default("EUR")
  cloudinaryPublicId String
  cloudinaryUrl      String
  thumbnailUrl       String?
  stripePriceId      String?
  stripeProductId    String?
  isActive           Boolean  @default(true)
  category           String
  tags               String[]
  translation        Json?
  createdAt          DateTime @db.Date
  updatedAt          DateTime @db.Date
}

// Purchase model for tracking book purchases
model Purchase {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  bookId          String   @db.ObjectId
  stripeSessionId String?
  stripePaymentId String?
  amount          Float
  currency        String
  status          String   @default("pending") // pending, completed, failed, refunded
  downloadToken   String?  @unique
  downloadCount   Int      @default(0)
  createdAt       DateTime @db.Date
  updatedAt       DateTime @db.Date
}

model Training {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  category        String
  content         String
  contentImage    String
  createdAt       DateTime @db.Date
  searchableTitle String
  solution        String
  solutionImage   String
  tags            String
  title           String
  updatedAt       DateTime @db.Date
  translation     Json?
}

model User {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime    @db.Date
  email     String      @unique
  password  String
  profile   UserProfile
  role      String
  updatedAt DateTime    @db.Date
  isActive  Boolean     @default(false)
}

model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @db.Date
  creatorName String
  description String
  tags        String[]
  title       String
  updatedAt   DateTime @db.Date
  url         String
  translation  Json?
}

// Q&A System models
model Question {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  body            String
  category        String
  tags            String[]
  authorId        String   @db.ObjectId
  authorName      String
  voteCount       Int      @default(0)
  answerCount     Int      @default(0)
  viewCount       Int      @default(0)
  acceptedAnswerId String? @db.ObjectId
  isResolved      Boolean  @default(false)
  createdAt       DateTime @db.Date
  updatedAt       DateTime @db.Date
}

model Answer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId  String   @db.ObjectId
  body        String
  authorId    String   @db.ObjectId
  authorName  String
  voteCount   Int      @default(0)
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @db.Date
  updatedAt   DateTime @db.Date
}

model QuestionVote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId String   @db.ObjectId
  userId     String   @db.ObjectId
  value      Int      // 1 for upvote, -1 for downvote
  createdAt  DateTime @db.Date

  @@unique([questionId, userId])
}

model AnswerVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  answerId  String   @db.ObjectId
  userId    String   @db.ObjectId
  value     Int      // 1 for upvote, -1 for downvote
  createdAt DateTime @db.Date

  @@unique([answerId, userId])
}

